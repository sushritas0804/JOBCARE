        </div>

        <!-- Waveform -->
        <div class="waveform-wrap" id="waveform">
            <svg class="wave-svg" viewBox="0 0 600 40" preserveAspectRatio="none">
                <path class="wave-path" d="" stroke="var(--accent)" stroke-width="1.5" fill="none" stroke-linecap="round"/>
            </svg>
        </div>

        <h1 class="voice-title">Tap to <span class="hl">Start Speaking</span></h1>
