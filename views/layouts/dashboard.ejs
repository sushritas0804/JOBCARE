<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dash-body">
    <aside class="dash-sidebar" id="sidebar">
        <div class="dash-sidebar-head">
            <a href="/employer/dashboard" class="dash-logo">
                <div class="logo-mark">JC</div>
                <div class="logo-word">JOB<span>CARE</span></div>
            </a>
        </div>

        <nav class="dash-nav">
            <a href="/employer/dashboard" class="dash-nav-item <%= activePage === 'overview' ? 'active' : '' %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                <span>Dashboard</span>
            </a>

            <a href="/employer/dashboard/jobs" class="dash-nav-item <%= activePage === 'jobs' ? 'active' : '' %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                <span>Jobs</span>
            </a>

            <div class="dash-nav-parent">
                <a href="/employer/dashboard/database" class="dash-nav-item <%= activePage === 'database' ? 'active' : '' %>" id="dbToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                    <span>Database</span>
                    <svg class="dash-chevron <%= activePage === 'database' ? 'open' : '' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </a>
                <div class="dash-nav-sub <%= activePage === 'database' ? 'open' : '' %>" id="dbSub">
                    <a href="/employer/dashboard/database/search" class="dash-nav-sub-item <%= activePage === 'database' && subPage === 'search' ? 'active' : '' %>">Search Candidates</a>
                    <a href="/employer/dashboard/database/saved" class="dash-nav-sub-item <%= activePage === 'database' && subPage === 'saved' ? 'active' : '' %>">Saved Candidates</a>
                    <a href="/employer/dashboard/database/unlocked" class="dash-nav-sub-item <%= activePage === 'database' && subPage === 'unlocked' ? 'active' : '' %>">Unlocked Candidates</a>
                </div>
            </div>

            <a href="/employer/dashboard/reports" class="dash-nav-item <%= activePage === 'reports' ? 'active' : '' %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
                <span>Reports</span>
            </a>

            <a href="/employer/dashboard/credits" class="dash-nav-item <%= activePage === 'credits' ? 'active' : '' %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                <span>Credits &amp; Usage</span>
            </a>

            <a href="/employer/dashboard/billing" class="dash-nav-item <%= activePage === 'billing' ? 'active' : '' %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M14 8H8"/><path d="M16 12H8"/></svg>
                <span>Billing</span>
            </a>
        </nav>

        <div class="dash-sidebar-foot">
            <a href="/employer/logout" class="dash-nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span>Log Out</span>
            </a>
        </div>
    </aside>

    <div class="dash-main">
        <header class="dash-topbar">
            <button class="dash-menu-toggle" id="menuToggle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <div class="dash-topbar-left">
                <span class="dash-page-title"><%= title.replace('JOBCARE - ', '') %></span>
            </div>
            <div class="dash-topbar-right">
                <div class="dash-profile" id="profileBtn">
                    <div class="dash-profile-circle">
                        <%= employer && employer.name ? employer.name.charAt(0).toUpperCase() : '?' %>
                    </div>
                    <div class="dash-profile-dropdown" id="profileDropdown">
                        <div class="dash-profile-info">
                            <strong><%= employer ? employer.name : '' %></strong>
                            <span><%= employer ? employer.workEmail : '' %></span>
                        </div>
                        <div class="dash-dropdown-divider"></div>
                        <a href="/employer/logout" class="dash-dropdown-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                            Log Out
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <main class="dash-content">
            <%- body %>
        </main>
    </div>

    <script>
    (function() {
        var toggle = document.getElementById('menuToggle');
        var sidebar = document.getElementById('sidebar');
        toggle.addEventListener('click', function() {
            sidebar.classList.toggle('open');
        });

        var dbToggle = document.getElementById('dbToggle');
        var dbSub = document.getElementById('dbSub');
        if (dbToggle) {
            dbToggle.addEventListener('click', function(e) {
                e.preventDefault();
                dbSub.classList.toggle('open');
                var chevron = dbToggle.querySelector('.dash-chevron');
                if (chevron) chevron.classList.toggle('open');
            });
        }

        var profileBtn = document.getElementById('profileBtn');
        var profileDropdown = document.getElementById('profileDropdown');
        if (profileBtn) {
            profileBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                profileDropdown.classList.toggle('open');
            });
            document.addEventListener('click', function() {
                profileDropdown.classList.remove('open');
            });
        }
    })();
    </script>
</body>
</html>
