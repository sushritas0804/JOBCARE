<div class="wizard-card">
    <%
        /* ─── Display helper functions ─── */
        var jobTitle = job.title === 'Other' ? (job.customTitle || 'Not specified') : (job.title || 'Not specified');
        var jobRole  = job.role === 'Other' ? (job.customRole || '') : (job.role || '');
        var jobTypeDisplay = '';
        if (job.jobType === 'full-time') jobTypeDisplay = 'Full Time';
        else if (job.jobType === 'part-time') jobTypeDisplay = 'Part Time';
        else if (job.jobType === 'both') jobTypeDisplay = 'Full Time | Part Time';

        var workDisplay = '';
        if (job.workLocation === 'office') workDisplay = 'Work from office';
        else if (job.workLocation === 'remote') workDisplay = 'Work from home';
        else if (job.workLocation === 'field') workDisplay = 'Field job';

        var cityDisplay = (job.citySearch && job.citySearch !== 'All' && job.citySearch !== '')
            ? 'Specific areas in ' + (job.citySearch || employer.city || '')
            : 'All Areas in ' + (employer.city || 'your city') + '/' + (employer.city || 'your city') + ' Region';

        var salaryDisplay = '';
        if (job.payType === 'fixed' || job.payType === 'fixed-incentive') {
            var minStr = job.payMin ? '₹ ' + job.payMin.toLocaleString('en-IN') : '₹ 0';
            var maxStr = job.payMax ? '₹ ' + job.payMax.toLocaleString('en-IN') : '₹ 0';
            if (job.payMin && job.payMax && job.payMin !== job.payMax) {
                salaryDisplay = minStr + ' - ' + maxStr + ' per month';
            } else if (job.payMin) {
                salaryDisplay = minStr + ' per month';
            } else {
                salaryDisplay = 'Not specified';
            }
            var payTypeLabel = job.payType === 'fixed' ? 'Fixed only' : 'Fixed + Incentive';
            salaryDisplay += ' (' + payTypeLabel + ')';
        } else if (job.payType === 'incentive') {
            salaryDisplay = 'Incentive only';
        } else {
            salaryDisplay = 'Not specified';
        }

        var perksList = (job.perks || []).filter(function(p) { return p !== 'Other'; });
        if (job.customPerk) perksList.push(job.customPerk);
        var perksDisplay = perksList.length > 0 ? perksList.join(', ') : 'None';

        var joiningFeeDisplay = job.joiningFee === 'yes' ? 'Yes' : 'No';

        var educationMap = {
            'below-10th': 'Below 10th', '10th': '10th Pass', '12th': '12th Pass',
            'diploma': 'Diploma', 'iti': 'ITI', 'graduate': 'Graduate', 'post-graduate': 'Post Graduate'
        };
        var educationDisplay = educationMap[job.minEducation] || 'Not specified';

        var englishMap = { 'none': 'No English', 'basic': 'Basic English', 'good': 'Good English' };
        var englishDisplay = englishMap[job.englishLevel] || 'Not specified';

        var experienceMap = { 'any': 'Any', 'experienced': 'Experienced', 'freshers': 'Freshers Only' };
        var experienceDisplay = experienceMap[job.experienceLevel] || 'Not specified';

        var genderDisplay = 'Both genders allowed';
        if (job.preferredGender === 'male') genderDisplay = 'Male only';
        else if (job.preferredGender === 'female') genderDisplay = 'Female only';

        var ageDisplay = '18 - 60 yrs';
        if (job.preferredAgeMin || job.preferredAgeMax) {
            var aMin = job.preferredAgeMin || 18;
            var aMax = job.preferredAgeMax || 60;
            ageDisplay = aMin + ' - ' + aMax + ' yrs';
        }

        var degreeDisplay = job.preferredDegree || 'No input selected';
        var industryDisplay = job.preferredIndustry || 'None';
        var jobDescDisplay = job.jobDescription || 'None';

        var walkInDisplay = '';
        if (job.isWalkIn === 'yes') {
            walkInDisplay = 'Yes, walk-in interview at ' + (job.companyAddress || 'company address');
            if (job.walkInFloorPlot) walkInDisplay += ', ' + job.walkInFloorPlot;
            if (job.walkInStartDate && job.walkInEndDate) {
                walkInDisplay += ' (' + job.walkInStartDate + ' to ' + job.walkInEndDate + ')';
            }
            if (job.walkInStartTime && job.walkInEndTime) {
                walkInDisplay += ' — ' + job.walkInStartTime + ' to ' + job.walkInEndTime;
            }
        } else if (job.isWalkIn === 'no') {
            walkInDisplay = 'No, I will share interview details later to the candidates';
        } else {
            walkInDisplay = 'Not specified';
        }

        var contactDisplay = '';
        if (job.contactPreference === 'self') contactDisplay = 'Yes';
        else if (job.contactPreference === 'other') contactDisplay = 'Yes';
        else if (job.contactPreference === 'none') contactDisplay = 'No';
        else contactDisplay = 'Not specified';

        var hrDisplay = '';
        if (job.contactPreference === 'other' && job.recruiterName) {
            hrDisplay = job.recruiterName;
            if (job.recruiterWhatsApp) hrDisplay += ', ' + job.recruiterWhatsApp;
            if (job.recruiterEmail) hrDisplay += ', ' + job.recruiterEmail;
        } else if (job.contactPreference === 'self') {
            hrDisplay = 'Self-managed';
        } else {
            hrDisplay = 'Not provided';
        }

        var alertsDisplay = job.whatsappAlerts === 'yes' ? 'For every application' : (job.whatsappAlerts === 'no' ? 'No alerts' : 'Not specified');
    %>

    <div class="wizard-section">
        <div class="preview-section">
            <!-- Section I: Job Details -->
            <div class="preview-section-head">
                <div class="preview-section-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </div>
                <h2>Job Details</h2>
                <a href="/employer/dashboard/jobs/create" class="preview-edit-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                    Edit
                </a>
            </div>

            <div class="preview-rows">
                <div class="preview-row">
                    <span class="preview-label">Company name</span>
                    <span class="preview-value"><%= job.companyName || 'Not specified' %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Job title</span>
                    <span class="preview-value"><%= jobTitle %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Job role / category</span>
                    <span class="preview-value"><%= jobRole || 'Not specified' %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Job type</span>
                    <span class="preview-value"><%= jobTypeDisplay || 'Not specified' %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Work type</span>
                    <span class="preview-value"><%= workDisplay || 'Not specified' %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Job City</span>
                    <span class="preview-value"><%= cityDisplay %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Monthly Salary | Pay Type</span>
                    <span class="preview-value"><%= salaryDisplay %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Additional perks</span>
                    <span class="preview-value"><%= perksDisplay %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Joining Fee</span>
                    <span class="preview-value"><%= joiningFeeDisplay %></span>
                </div>
            </div>
        </div>

        <div class="preview-section">
            <!-- Section II: Candidate Requirements -->
            <div class="preview-section-head">
                <div class="preview-section-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h2>Candidate Requirements</h2>
                <a href="/employer/dashboard/jobs/create/step2" class="preview-edit-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                    Edit
                </a>
            </div>

            <!-- Eligible Requirements -->
            <div class="preview-subhead">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span>Eligible Requirements</span>
            </div>
            <p class="preview-subhead-desc">Your job will only be visible to the candidates who meet these requirements.</p>

            <div class="preview-rows">
                <div class="preview-row">
                    <span class="preview-label">Minimum Education</span>
                    <span class="preview-value"><%= educationDisplay %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Experience Required</span>
                    <span class="preview-value"><%= experienceDisplay %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">English</span>
                    <span class="preview-value"><%= englishDisplay %></span>
                </div>
            </div>

            <!-- Preferred Requirements -->
            <div class="preview-subhead">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span>Preferred Requirements</span>
            </div>
            <p class="preview-subhead-desc">Your job will be promoted to the candidates meeting below requirements, but others can still apply.</p>

            <div class="preview-rows">
                <div class="preview-row">
                    <span class="preview-label">Age</span>
                    <span class="preview-value"><%= ageDisplay %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Gender</span>
                    <span class="preview-value"><%= genderDisplay %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Degree / Specialization</span>
                    <span class="preview-value"><%= degreeDisplay %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Industry</span>
                    <span class="preview-value"><%= industryDisplay %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Job Description</span>
                    <span class="preview-value"><%= jobDescDisplay %></span>
                </div>
            </div>
        </div>

        <div class="preview-section">
            <!-- Section III: Interview Information -->
            <div class="preview-section-head">
                <div class="preview-section-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h2>Interview Information</h2>
                <a href="/employer/dashboard/jobs/create/step3" class="preview-edit-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                    Edit
                </a>
            </div>

            <div class="preview-rows">
                <div class="preview-row">
                    <span class="preview-label">Is this a walk-in interview ?</span>
                    <span class="preview-value"><%= walkInDisplay %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Company address</span>
                    <span class="preview-value"><%= job.companyAddress || 'Not specified' %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">HR Details</span>
                    <span class="preview-value"><%= hrDisplay %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Can candidates contact</span>
                    <span class="preview-value"><%= contactDisplay %></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">JOBCARE Alerts</span>
                    <span class="preview-value"><%= alertsDisplay %></span>
                </div>
            </div>
        </div>
    </div>

    <div class="wizard-actions">
        <a href="/employer/dashboard/jobs/create/step3" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            <span>Back</span>
        </a>
        <a href="/employer/dashboard/jobs/create/step5" class="btn btn-primary">
            <span>Continue</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
    </div>
</div>
