<script>
document.getElementById('micBtn').addEventListener('click', function() {
    var hint = document.getElementById('voiceHint');
    if (this.classList.contains('listening')) {
        this.classList.remove('listening');
        this.style.borderColor = '';
        this.style.boxShadow = '';
        hint.textContent = 'Click the microphone to begin';
        hint.style.color = '';
    } else {
        this.classList.add('listening');
        this.style.borderColor = 'rgba(99, 102, 241, 0.5)';
        this.style.boxShadow = '0 0 60px rgba(99, 102, 241, 0.3)';
        hint.textContent = 'Listening... tap to stop';
        hint.style.color = 'var(--accent)';
    }
});
</script>
