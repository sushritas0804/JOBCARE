<div class="wizard-card">
    <% if (error) { %>
        <div class="wizard-error"><%= error %></div>
    <% } %>

    <form action="/employer/dashboard/jobs/create/step5" method="POST" id="step5Form">
        <input type="hidden" name="subscriptionPlan" id="planHidden" value="<%= job.subscriptionPlan || '' %>">
        <input type="hidden" name="perPlacementFee" id="perPlacementHidden" value="<%= job.perPlacementFee || '' %>">

        <!-- ═══ Section I: Subscription Plans ═══ -->
        <div class="wizard-section">
            <h2 class="wizard-section-title">Choose Your Plan</h2>
            <p class="wizard-section-desc">Select a subscription plan to publish your job listing. All plans include a 7-day free trial.</p>

            <div class="plan-cards">
                <!-- Starter -->
                <div class="plan-card" data-plan="starter">
                    <div class="plan-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    </div>
                    <h3 class="plan-name">Starter</h3>
                    <div class="plan-price">&#8377;999<span>/month</span></div>
                    <ul class="plan-features">
                        <li class="plan-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>50 job views</span>
                        </li>
                        <li class="plan-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>15 days live</span>
                        </li>
                        <li class="plan-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>Basic listing</span>
                        </li>
                        <li class="plan-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>7-day free trial</span>
                        </li>
                    </ul>
                    <div class="plan-select">Select Plan</div>
                </div>

                <!-- Growth -->
                <div class="plan-card plan-card-popular" data-plan="growth">
                    <div class="plan-badge">MOST POPULAR</div>
                    <div class="plan-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
                    </div>
                    <h3 class="plan-name">Growth</h3>
                    <div class="plan-price">&#8377;2,499<span>/month</span></div>
                    <ul class="plan-features">
                        <li class="plan-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>200 job views</span>
                        </li>
                        <li class="plan-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>30 days live</span>
                        </li>
                        <li class="plan-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>Featured listing</span>
                        </li>
                        <li class="plan-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>7-day free trial</span>
                        </li>
                    </ul>
                    <div class="plan-select">Select Plan</div>
                </div>

                <!-- Premium -->
                <div class="plan-card" data-plan="premium">
                    <div class="plan-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                    </div>
                    <h3 class="plan-name">Premium</h3>
                    <div class="plan-price">&#8377;4,999<span>/month</span></div>
                    <ul class="plan-features">
                        <li class="plan-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>Unlimited views</span>
                        </li>
                        <li class="plan-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>60 days live</span>
                        </li>
                        <li class="plan-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>Premium listing</span>
                        </li>
                        <li class="plan-feature">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>7-day free trial</span>
                        </li>
                    </ul>
                    <div class="plan-select">Select Plan</div>
                </div>
            </div>
        </div>

        <!-- ═══ Section II: Per-Placement Fee ═══ -->
        <div class="wizard-section">
            <h2 class="wizard-section-title">Per-Placement Fee <span class="wizard-section-optional">(Optional)</span></h2>

            <div class="perk-placement-card">
                <div class="perk-placement-head">
                    <div class="perk-placement-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <div>
                        <h3 class="perk-placement-title">Pay only when you hire</h3>
                        <p class="perk-placement-desc">Set a per-placement fee that will be charged for each successful candidate hire.</p>
                    </div>
                </div>
                <div class="perk-placement-select">
                    <label>Fee per hire</label>
                    <select name="perPlacementFeeSelect" id="perPlacementSelect">
                        <option value="">No, I'll skip this</option>
                        <option value="150" <%= job.perPlacementFee === '150' ? 'selected' : '' %>>&#8377;150 per hire (Entry-level roles)</option>
                        <option value="200" <%= job.perPlacementFee === '200' ? 'selected' : '' %>>&#8377;200 per hire</option>
                        <option value="300" <%= job.perPlacementFee === '300' ? 'selected' : '' %>>&#8377;300 per hire</option>
                        <option value="400" <%= job.perPlacementFee === '400' ? 'selected' : '' %>>&#8377;400 per hire</option>
                        <option value="500" <%= job.perPlacementFee === '500' ? 'selected' : '' %>>&#8377;500 per hire (Senior roles)</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="wizard-actions">
            <a href="/employer/dashboard/jobs/create/step4" class="btn btn-secondary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                <span>Back</span>
            </a>
            <button type="submit" class="btn btn-primary" id="publishBtn" disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 17V3"/><path d="m6 11 6 6 6-6"/><path d="M19 21H5"/></svg>
                <span>Publish this job</span>
            </button>
        </div>
    </form>
</div>

<script>
(function() {
    var planHidden = document.getElementById('planHidden');
    var perPlacementHidden = document.getElementById('perPlacementHidden');
    var perPlacementSelect = document.getElementById('perPlacementSelect');
    var publishBtn = document.getElementById('publishBtn');
    var planCards = document.querySelectorAll('.plan-card');

    /* ─── Plan selection ─── */
    planCards.forEach(function(card) {
        card.addEventListener('click', function() {
            planCards.forEach(function(c) { c.classList.remove('selected'); });
            card.classList.add('selected');
            planHidden.value = card.dataset.plan;
            publishBtn.disabled = false;
        });
    });

    /* Pre-select if returning with error */
    <% if (job.subscriptionPlan) { %>
        planCards.forEach(function(card) {
            if (card.dataset.plan === '<%= job.subscriptionPlan %>') {
                card.classList.add('selected');
                planHidden.value = '<%= job.subscriptionPlan %>';
                publishBtn.disabled = false;
            }
        });
    <% } %>

    /* ─── Per-placement sync ─── */
    perPlacementSelect.addEventListener('change', function() {
        perPlacementHidden.value = perPlacementSelect.value;
    });
    perPlacementHidden.value = perPlacementSelect.value;
})();
</script>
