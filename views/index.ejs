<section class="hero">
    <div class="hero-content">
        <div class="hero-badge">
            <span class="pulse-dot"></span>
            AI-Powered Job Matching
        </div>
        <h1>
            Your Skills Deserve<br>
            the <span class="hl">Right Opportunity</span>
        </h1>
        <p class="hero-sub">
            Tell our AI what you're good at and what you're looking for.
            We match freshers and job seekers with roles that actually fit —
            no more endless scrolling through irrelevant listings.
        </p>
        <div class="hero-actions">
            <a href="/ai-voice" class="btn btn-primary btn-lg">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/></svg>
