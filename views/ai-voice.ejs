<script>
(function() {
    var mic = document.getElementById('micBtn');
    var hint = document.getElementById('voiceHint');
    var wave = document.getElementById('waveform');
    var listening = false;
    var animFrame;

    // Minimalist sine waveform
    function drawWave(time) {
        var path = wave.querySelector('.wave-path');
        var w = 600, h = 40, mid = h / 2;
        var d = 'M 0 ' + mid;
        for (var x = 0; x <= w; x += 2) {
            var amp = listening ? 12 : 0;
            var freq = listening ? 0.03 : 0;
            var y = mid + Math.sin(x * freq + time * 0.003) * amp * Math.sin(x * 0.005 + time * 0.001);
            d += ' L ' + x + ' ' + y;
        }
        path.setAttribute('d', d);
        animFrame = requestAnimationFrame(function() { drawWave(time + 16); });
    }

    drawWave(0);

    mic.addEventListener('click', function() {
        listening = !listening;
        if (listening) {
            mic.classList.add('listening');
            hint.textContent = 'Listening... tap to stop';
            hint.style.color = 'var(--accent)';
            wave.classList.add('active');
        } else {
            mic.classList.remove('listening');
            hint.textContent = 'Click the microphone to begin';
            hint.style.color = '';
            wave.classList.remove('active');
        }
    });
})();
</script>
